# Copy to .env and fill in. Never commit .env. No customer data in this file.

# --- Microsoft Foundry (Azure AI Foundry) project -----------------------------------
# Copy this verbatim from the Foundry portal:
#   your project -> Overview -> "Azure AI Foundry project endpoint"
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# The DEPLOYMENT name from Models + endpoints (often NOT the model name).
# Verify with:
#   az cognitiveservices account deployment list --name <resource> --resource-group <rg> -o table
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# --- Identity ------------------------------------------------------------------------
# THE TENANT TRAP. If you are signed in to more than one Entra directory (very common
# on corporate or AVD machines), DefaultAzureCredential may hand back a token from the
# wrong one and the service replies:
#     400 - Token tenant <guid> does not match resource tenant.
#
# Find the tenant that OWNS the Foundry resource:
#   az account list --query "[?id=='<your-sub-id>'].{sub:name, tenant:tenantId}" -o table
# Then:
#   az login --tenant <TENANT_ID>
#   az account set --subscription <SUB_ID>
# ...and set both of these:
AZURE_TENANT_ID=
LAB_USE_CLI_CREDENTIAL=1

# --- A2A servers: three agents, three ports, one laptop ------------------------------
A2A_HOST=127.0.0.1
PORT_SIGNAL=9001
PORT_CASES=9002
PORT_COE=9003
