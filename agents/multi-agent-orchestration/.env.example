# Copy to .env and fill in. Never commit .env. No customer data in this file.

# Microsoft Foundry (Azure AI Foundry) project
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# A2A servers - three agents, three ports, one laptop
A2A_HOST=127.0.0.1
PORT_SIGNAL=9001
PORT_CASES=9002
PORT_COE=9003
