{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workbookDisplayName": {
      "type": "string",
      "defaultValue": "Azure VM Capacity Restrictions (v1-v4)"
    }
  },
  "variables": {
    "workbookContent": "[uri('https://raw.githubusercontent.com/babulalghule24/azure-monitor-observability-hub/main/workbooks/azure-vm-capacity-restrictions-v1-v4/workbook.json','')]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/workbooks",
      "apiVersion": "2018-06-17-preview",
      "name": "[newGuid()]",
      "location": "[resourceGroup().location]",
      "kind": "shared",
      "properties": {
        "displayName": "[parameters('workbookDisplayName')]",
        "version": "1.0",
        "sourceId": "Azure Monitor",
        "category": "workbook",
        "serializedData": "[string(reference(variables('workbookContent')))]"
      }
    }
  ]
}